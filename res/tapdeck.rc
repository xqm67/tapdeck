1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TapDeck"
            VALUE "FileDescription", "TapDeck: la tua Stream Deck fatta in casa"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "tapdeck"
            VALUE "OriginalFilename", "tapdeck.exe"
            VALUE "ProductName", "TapDeck"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "Progetto personale"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
